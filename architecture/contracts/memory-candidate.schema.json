{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Daksh memory-candidate",
  "required": [
    "schema_version",
    "id",
    "kind",
    "scope",
    "claim",
    "source",
    "status",
    "confidence",
    "review_condition"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "direct_correction",
        "preference",
        "project_rule",
        "research",
        "hypothesis",
        "failure_pattern"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "target"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "scene": {
          "type": "string",
          "minLength": 1
        },
        "shot": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "observed_on"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "observed_on": {
          "type": "string",
          "format": "date"
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "enum": [
        "proposed",
        "verified",
        "approved",
        "superseded",
        "rejected"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "review_condition": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {
      "type": "string",
      "minLength": 1
    }
  }
}
