{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Daksh task",
  "required": [
    "schema_version",
    "task_id",
    "objective",
    "owner",
    "scope",
    "source_versions",
    "locks",
    "permissions",
    "acceptance_criteria",
    "budget"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "const": "daksh-brain"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "target"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "scene": {
          "type": "string",
          "minLength": 1
        },
        "shot": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "minProperties": 1
    },
    "locks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_parallel",
        "max_attempts",
        "paid_generation_authorized"
      ],
      "properties": {
        "max_parallel": {
          "type": "integer",
          "minimum": 1
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "paid_generation_authorized": {
          "type": "boolean"
        },
        "spend_limit": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
